{
  "appId": "com.campconnect.app",
  "appName": "CampConnect",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#faf7f0"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 450,
      "launchAutoHide": true,
      "launchFadeOutDuration": 220,
      "backgroundColor": "#faf7f0",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
